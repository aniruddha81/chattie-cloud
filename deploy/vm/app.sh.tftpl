#!/bin/bash
# First-boot script for an app VM. Both clouds run this as VM user data.
# It installs Docker, pulls the chattie image that GitHub Actions built, and
# runs two containers from it: the chat instance (serve) and the outbox
# publisher.
# Log: /var/log/cloud-init-output.log
set -euxo pipefail

apt-get update
apt-get -o DPkg::Lock::Timeout=300 install -y docker.io

docker pull ${image}

# The managed database only accepts encrypted connections (sslmode=require).
cat > /etc/chattie.env <<'EOF'
DATABASE_URL=postgres://chattie:${db_password}@${db_host}:5432/chattie?sslmode=require&pool_max_conns=${db_pool}
REDIS_URL=redis://${redis_host}:6379
SESSION_SECRET=${session_secret}
DRAIN_SECONDS=10
EOF
chmod 600 /etc/chattie.env

# --restart always brings a container back after a crash or a VM reboot. It
# also covers boot order: the app retries until the database is ready.
docker run -d --name chattie --restart always --stop-timeout 30 \
  --env-file /etc/chattie.env -e INSTANCE_ID="$(hostname)" \
  -p 8080:8080 ${image} serve

docker run -d --name chattie-publisher --restart always \
  --env-file /etc/chattie.env -e INSTANCE_ID="$(hostname)" \
  ${image} publisher

# A helper to look inside the database from this VM:
#   chattie-psql -c "SELECT count(*) FROM messages"
# Set DB_HOST to look at another server, such as a restored copy.
cat > /usr/local/bin/chattie-psql <<'EOF'
#!/bin/sh
exec docker run --rm -i -e PGPASSWORD='${db_password}' postgres:18-alpine \
  psql "host=$${DB_HOST:-${db_host}} user=chattie dbname=chattie sslmode=require" "$@"
EOF
chmod 700 /usr/local/bin/chattie-psql
